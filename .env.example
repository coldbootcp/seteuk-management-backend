# --- 필수 ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seteuk
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM ---
# 모델 프로바이더는 하네스 경계 뒤에 있다. 지금 붙어 있는 것은 DeepSeek 하나지만,
# 호출부를 바꾸지 않고 교체할 수 있어야 한다.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 생기부 파싱 시 블록 단위 LLM 호출 동시 실행 수
SETEUK_LLM_CONCURRENCY=15

# --- 소셜 로그인 (카카오) ---
# 백엔드는 클라이언트가 받아온 kakao_access_token만 검증하므로
# 아래 값은 클라이언트 SDK 설정용이며 서버 동작에는 필수가 아니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 사용량 한도 (사용자별 24시간 슬라이딩 윈도우) ---
DAILY_UPLOAD_LIMIT=5
DAILY_DIAGNOSIS_LIMIT=5
DAILY_ROADMAP_LIMIT=10
DAILY_RECOMMENDATION_LIMIT=20
DAILY_CHAT_MESSAGE_LIMIT=100
# 위 한도를 실제로 적용할지. 비워 두면 ENVIRONMENT로 정한다 —
# production/prod/staging에서만 켜지고 그 밖(local 등)에서는 풀린다.
# 개발 중에 같은 시나리오를 하루에도 수십 번 태워야 하기 때문이다.
# 로컬에서 한도 동작을 확인하고 싶으면 true로 두면 된다.
# RATE_LIMIT_ENABLED=true

# --- 웹 프론트엔드 ---
# 브라우저에서 이 API를 호출할 오리진 목록(콤마 구분). 프론트엔드는 별도
# 프로젝트라 항상 다른 오리진에서 돈다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# --- 운영 ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# 운영 배포에서는 true(JSON 한 줄 로그)
LOG_JSON=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# processing 상태로 이 시간을 넘긴 job은 기동 시 실패 처리
STALE_JOB_TIMEOUT_MINUTES=30
