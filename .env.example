# --- 필수 ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seteuk
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM ---
# 모델 프로바이더는 하네스 경계 뒤에 있다. 지금 붙어 있는 것은 DeepSeek 하나지만,
# 호출부를 바꾸지 않고 교체할 수 있어야 한다.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 생기부 파싱 시 블록 단위 LLM 호출 동시 실행 수
SETEUK_LLM_CONCURRENCY=15

# --- 소셜 로그인 (카카오) ---
# 백엔드는 클라이언트가 받아온 kakao_access_token만 검증하므로
# 아래 값은 클라이언트 SDK 설정용이며 서버 동작에는 필수가 아니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 소셜 로그인 (구글) ---
# 카카오와 완전히 같은 패턴 — 백엔드는 클라이언트가 받아온 google_access_token만
# 검증하므로(구글 userinfo API 직접 호출) 아래 값은 클라이언트 SDK 설정용이며
# 서버 동작에는 필수가 아니다. Google Cloud Console에서 발급.
GOOGLE_CLIENT_ID=

# --- 이메일 발송 (Resend, resend.com) ---
# 이메일 인증·비밀번호 재설정 메일을 실제로 보내려면 필요하다. 비워 두면
# (로컬 개발 등) 실제로 보내지 않고 로그로만 남긴다 — 카카오 버튼이 키 없으면
# '준비 중'으로 빠지는 것과 같은 자세.
RESEND_API_KEY=
# Resend에 검증된 발신 도메인의 주소여야 한다. 자체 도메인이 없으면 우선
# Resend가 제공하는 테스트 발신 주소(onboarding@resend.dev)로 시작할 수 있다.
EMAIL_FROM=세특연구소 <onboarding@resend.dev>
# 인증·재설정 메일의 링크가 가리킬 프론트엔드 주소.
FRONTEND_BASE_URL=http://localhost:3100
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# 회원 탈퇴 요청 후 완전 삭제까지의 유예 기간(일). 그 안에는 재로그인해
# 탈퇴를 취소할 수 있다.
ACCOUNT_DELETION_GRACE_DAYS=30

# --- 사용량 한도 (사용자별 24시간 슬라이딩 윈도우) ---
DAILY_UPLOAD_LIMIT=5
DAILY_DIAGNOSIS_LIMIT=5
DAILY_ROADMAP_LIMIT=10
DAILY_RECOMMENDATION_LIMIT=20
DAILY_CHAT_MESSAGE_LIMIT=100
# 위 한도를 실제로 적용할지. 비워 두면 ENVIRONMENT로 정한다 —
# production/prod/staging에서만 켜지고 그 밖(local 등)에서는 풀린다.
# 개발 중에 같은 시나리오를 하루에도 수십 번 태워야 하기 때문이다.
# 로컬에서 한도 동작을 확인하고 싶으면 true로 두면 된다.
# RATE_LIMIT_ENABLED=true

# --- 웹 프론트엔드 ---
# 브라우저에서 이 API를 호출할 오리진 목록(콤마 구분). 프론트엔드는 별도
# 프로젝트라 항상 다른 오리진에서 돈다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# --- 운영 ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# 운영 배포에서는 true(JSON 한 줄 로그)
LOG_JSON=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# processing 상태로 이 시간을 넘긴 job은 기동 시 실패 처리
STALE_JOB_TIMEOUT_MINUTES=30
